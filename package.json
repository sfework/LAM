{
  "name": "local-agent-memory-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "个人本地 Agent 记忆网关：透明 OpenAI 网关 + 记忆/知识/CodeGraph 管理后端（参考 TencentDB-Agent-Memory 简化重设计）",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "node --watch --import tsx --liftoff-only src/server.ts",
    "start": "node --import tsx --liftoff-only src/server.ts",
    "build:cg": "node scripts/build-codegraph.mjs",
    "build:web": "cd frontend && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "node scripts/simulate-usage.mjs",
    "bench:recall": "node --import tsx --liftoff-only scripts/bench-recall.mjs",
    "test:extract": "node --import tsx --liftoff-only scripts/test-extract.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.1.0",
    "chokidar": "^4.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "mssql": "^12.7.2",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "sqlite-vec": "^0.1.7-alpha.2",
    "tree-sitter-wasms": "^0.1.13",
    "undici": "^7.4.0",
    "web-tree-sitter": "^0.25.0"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.0",
    "tsdown": "^0.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
