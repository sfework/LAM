{
  "name": "nlam",
  "version": "2.0.0",
  "private": true,
  "description": "本地 Agent 记忆网关（LAM 重写版）：透明 OpenAI 网关 + 对话/记忆/画像管理后端 + MCP 工具库",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch --import tsx --liftoff-only src/server.ts",
    "start": "node --import tsx --liftoff-only src/server.ts",
    "build:web": "cd frontend && pnpm install && pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:from-lam": "node --import tsx scripts/migrate-from-lam.mjs",
    "seed:consolidation-agent": "node scripts/seed-consolidation-agent.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.1.0",
    "hono": "^4.7.0",
    "mssql": "^12.7.2",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "sqlite-vec": "^0.1.7-alpha.2",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
